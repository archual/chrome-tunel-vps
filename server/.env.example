# Copy to server/.env (chmod 600). Never commit the filled file.

# Public DNS name covered by the Let's Encrypt certificate.
PROXY_DOMAIN=proxy.k1812.ru
# Contact address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=admin@example.com

# Host port that publishes the TLS proxy. Only this port is exposed.
PUBLIC_PORT=443
# uid/gid of the unprivileged proxy container. Scripts chown passwd/certs/logs
# to this owner when run as root.
PROXY_UID=1000
PROXY_GID=1000
# Public IPv4 of the VPS. When set, CONNECT back to the proxy itself is denied.
PROXY_PUBLIC_IP=
# Optional comma-separated extra CIDRs to deny (for example, your office LAN).
DENY_EXTRA_CIDRS=

# Used by scripts/healthcheck.sh and scripts/smoke-test.sh, not by 3proxy.
PROXY_HEALTH_HOST=127.0.0.1
PROXY_CA_FILE=
SMOKE_USER=
SMOKE_PASSWORD=

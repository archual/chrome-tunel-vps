{
  "name": "chrome-tunel-vps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that routes browser traffic through an authenticated VPS proxy",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --config extension/vite.config.ts --watch",
    "build": "vite build --config extension/vite.config.ts",
    "package": "bash scripts/build-extension.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "archiver": "^7.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
